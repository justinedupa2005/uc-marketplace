{
  "name": "uc-marketplace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "env:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deployment/check.mjs",
    "env:local": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deployment/local.mjs",
    "auth:plan": "node scripts/auth/configure.mjs plan",
    "auth:configure": "node scripts/auth/configure.mjs apply",
    "build": "next build",
    "check": "npm run typecheck && npm run lint && npm test",
    "db:types": "node scripts/staging/types.mjs --write",
    "db:types:check": "node scripts/staging/types.mjs",
    "staging:audit": "node scripts/staging/audit.mjs",
    "staging:acceptance": "node scripts/staging/acceptance.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --test-concurrency=1 --experimental-strip-types tests/*.test.mjs",
    "test:db": "node scripts/qa/database.mjs",
    "test:e2e": "playwright test --project=anonymous-chromium",
    "test:e2e:qa": "playwright test --project=qa-chromium",
    "test:qa": "node scripts/qa/integration.mjs",
    "test:qa:api": "node scripts/qa/integration.mjs --api-only",
    "qa:local": "node scripts/qa/local.mjs",
    "qa:security": "node scripts/qa/security-hygiene.mjs",
    "qa:security:bundles": "node scripts/qa/security-hygiene.mjs --bundles",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "qa:dependencies": "node scripts/qa/dependencies.mjs",
    "qa:secrets": "node scripts/qa/repository-secrets.mjs",
    "qa:release": "node scripts/qa/release.mjs",
    "staging:plan": "node scripts/staging/migrate.mjs --plan",
    "staging:migrate": "node scripts/staging/migrate.mjs --apply",
    "staging:seed": "node scripts/staging/seed.mjs",
    "staging:verify": "node scripts/staging/verify.mjs",
    "staging:hosting": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deployment/staging.mjs",
    "staging:hosting:smoke": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/deployment/staging-smoke.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pg": "^8.23.1",
    "supabase": "^2.117.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
